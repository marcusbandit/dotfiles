@@ -4,6 +4,7 @@
 import QtQuick
 import Quickshell
 import Quickshell.Io
+import Caelestia
 
 Singleton {
     id: root
@@ -36,8 +37,22 @@
     // nmcli reports "unavailable" for ethernet NICs with no link, so we treat
     // anything other than that as a usable connection.
     readonly property bool hasAvailableEthernet: ethernetDevices.some(d => d.state !== "unavailable")
+    // NetworkManager connectivity state: full, portal, limited, none or unknown.
+    // "portal" means a captive portal is intercepting traffic (login page needed).
+    property string connectivity: "unknown"
+    readonly property bool captivePortal: connectivity === "portal"
     property list<var> activeProcesses: []
 
+    onCaptivePortalChanged: {
+        if (captivePortal)
+            Toaster.toast(qsTr("Sign-in required"), qsTr("This network needs a browser login"), "captive_portal");
+    }
+
+    // A single connectivity check at activation can race the portal (seen at
+    // espressohouse: NM said full, the portal engaged moments later). Force a
+    // burst of rechecks after every connection change to catch late portals.
+    onActiveConnectionChanged: connectivityRecheck.begin()
+
     readonly property alias connectionCheckTimer: connectionCheckTimer
     readonly property alias immediateCheckTimer: immediateCheckTimer
 
@@ -1504,7 +1519,12 @@
                 LC_ALL: "C.UTF-8"
             })
         stdout: SplitParser {
-            onRead: root.refreshOnConnectionChange()
+            onRead: data => {
+                const conn = data.match(/Connectivity is now '(\w+)'/);
+                if (conn)
+                    root.connectivity = conn[1];
+                root.refreshOnConnectionChange();
+            }
         }
         onExited: monitorRestartTimer.start() // qmllint disable signal-handler-parameters
     }
@@ -1515,6 +1535,53 @@
         interval: 2000
         onTriggered: {
             monitorProc.running = true;
+            connectivityProc.running = true; // Re-seed, changes may have been missed while the monitor was down
+        }
+    }
+
+    Process {
+        id: connectivityProc
+
+        running: true
+        command: ["nmcli", "-t", "-f", "CONNECTIVITY", "general"]
+        stdout: StdioCollector {
+            onStreamFinished: root.connectivity = text.trim()
+        }
+    }
+
+    Timer {
+        id: connectivityRecheck
+
+        property int attempt: 0
+        readonly property list<int> delays: [3000, 8000, 15000, 30000, 60000]
+
+        function begin(): void {
+            attempt = 0;
+            interval = delays[0];
+            restart();
+        }
+
+        onTriggered: {
+            recheckProc.running = true;
+            if (attempt < delays.length - 1) {
+                attempt++;
+                interval = delays[attempt];
+                restart();
+            }
+        }
+    }
+
+    Process {
+        id: recheckProc
+
+        // Forces NM to re-probe right now and prints the resulting state
+        command: ["nmcli", "-t", "networking", "connectivity", "check"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                const state = text.trim();
+                if (state)
+                    root.connectivity = state;
+            }
         }
     }
 
