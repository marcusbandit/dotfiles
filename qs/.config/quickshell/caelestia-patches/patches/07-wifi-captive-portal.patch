@@ -1515,6 +1537,70 @@
         interval: 2000
         onTriggered: {
             monitorProc.running = true;
+            probeProc.running = true; // Re-seed, changes may have been missed while the monitor was down
+        }
+    }
+
+    // Own captive-portal probe (same technique as Firefox), because NM's
+    // connectivity checker cannot be relied on (found disabled at runtime on
+    // this box while a portal was provably intercepting traffic).
+    Process {
+        id: probeProc
+
+        running: true
+        command: ["curl", "-sm", "5", "-w", "\n%{http_code} %{redirect_url}", "http://detectportal.firefox.com/success.txt"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                const lines = text.trim().split("\n");
+                const status = (lines.pop() ?? "").trim();
+                const body = lines.join("\n").trim();
+                const code = parseInt(status.split(" ")[0], 10) || 0;
+                const redirect = status.split(" ").slice(1).join(" ");
+
+                if (code === 200 && body === "success") {
+                    root.connectivity = "full";
+                    root.portalUrl = "";
+                } else if (code >= 200) {
+                    // Redirected or content tampered with: captive portal
+                    root.connectivity = "portal";
+                    root.portalUrl = redirect;
+                } else {
+                    root.connectivity = root.isConnected ? "limited" : "none";
+                }
+            }
+        }
+    }
+
+    Timer {
+        id: probeTimer
+
+        running: root.isConnected
+        repeat: true
+        triggeredOnStart: true
+        // Probe aggressively until the network is confirmed good
+        interval: root.connectivity === "full" ? 60000 : 15000
+        onTriggered: probeProc.running = true
+    }
+
+    Timer {
+        id: connectivityRecheck
+
+        property int attempt: 0
+        readonly property list<int> delays: [3000, 8000, 15000, 30000, 60000]
+
+        function begin(): void {
+            attempt = 0;
+            interval = delays[0];
+            restart();
+        }
+
+        onTriggered: {
+            probeProc.running = true;
+            if (attempt < delays.length - 1) {
+                attempt++;
+                interval = delays[attempt];
+                restart();
+            }
         }
     }
 
