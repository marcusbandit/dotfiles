+pragma ComponentBehavior: Bound
+
+import QtQuick
+
+Item {
+    id: root
+
+    // "idle" | "scanning" | "confirming"
+    property string phase: "idle"
+
+    // Eyelid poses (normalised 0..1 of the item box), tuned in the eye editor.
+    // Corners: inner/outer. Cubic lid controls: uc1/uc2 (upper), lc1/lc2 (lower).
+    readonly property var relaxed: ({
+            inner: { x: 0.1135, y: 0.6454 },
+            outer: { x: 0.9038, y: 0.3771 },
+            uc1: { x: 0.2635, y: 0.3137 },
+            uc2: { x: 0.5346, y: 0.2185 },
+            lc1: { x: 0.4308, y: 0.6795 },
+            lc2: { x: 0.6423, y: 0.6746 }
+        })
+    readonly property var intense: ({
+            inner: { x: 0.1135, y: 0.6454 },
+            outer: { x: 0.9038, y: 0.3771 },
+            uc1: { x: 0.2635, y: 0.3137 },
+            uc2: { x: 0.4327, y: 0.0893 },
+            lc1: { x: 0.4288, y: 0.7112 },
+            lc2: { x: 0.6827, y: 0.8332 }
+        })
+
+    // Iris placement (normalised); tomoe/ring/pupil use the official SVG ratios.
+    readonly property real irisR: 0.26     // of item height
+    readonly property real irisCX: 0.505
+    readonly property real irisCY: 0.485
+
+    // Lid state: 0 = closed, 1 = relaxed (scan), 2 = intense (stare).
+    property real lidT: 0
+    property real spin: 0
+    property real pupilScale: 1
+    property real ringGlow: 0
+
+    readonly property real spinSpeed: phase === "confirming" ? 400 : phase === "scanning" ? 100 : 0
+    property real _pupilTarget: phase === "confirming" ? 0.9 : 1
+    on_PupilTargetChanged: pupilScale = _pupilTarget
+
+    implicitWidth: 300
+    implicitHeight: 238
+
+    onLidTChanged: canvas.requestPaint()
+    onSpinChanged: canvas.requestPaint()
+    onPupilScaleChanged: canvas.requestPaint()
+    onRingGlowChanged: canvas.requestPaint()
+
+    onPhaseChanged: {
+        if (phase === "idle") {
+            lidT = 0;
+            ringGlow = 0;
+        } else if (phase === "scanning") {
+            lidT = 1;
+        } else if (phase === "confirming") {
+            lidT = 2;
+            ringGlow = 0.45;
+        }
+    }
+
+    Behavior on lidT {
+        NumberAnimation {
+            duration: 300
+            easing.type: Easing.OutBack
+            easing.overshoot: 1.7
+        }
+    }
+    Behavior on pupilScale {
+        NumberAnimation {
+            duration: 420
+            easing.type: Easing.OutCubic
+        }
+    }
+
+    // --- pose maths ------------------------------------------------------
+    function _lerp(a, b, k) {
+        return {
+            x: a.x + (b.x - a.x) * k,
+            y: a.y + (b.y - a.y) * k
+        };
+    }
+    // Project a control point onto the inner->outer line (a shut lid).
+    function _proj(p, i, o) {
+        const ax = o.x - i.x;
+        const ay = o.y - i.y;
+        const t = ((p.x - i.x) * ax + (p.y - i.y) * ay) / (ax * ax + ay * ay);
+        return {
+            x: i.x + ax * t,
+            y: i.y + ay * t
+        };
+    }
+    function poseAt(t: real): var {
+        const R = root.relaxed;
+        const N = root.intense;
+        // Allow a little open-overshoot (pop) but never undershoot closed.
+        t = Math.min(2.18, Math.max(0, t));
+        if (t <= 1) {
+            const k = t;
+            const cl = {
+                inner: R.inner,
+                outer: R.outer,
+                uc1: root._proj(R.uc1, R.inner, R.outer),
+                uc2: root._proj(R.uc2, R.inner, R.outer),
+                lc1: root._proj(R.lc1, R.inner, R.outer),
+                lc2: root._proj(R.lc2, R.inner, R.outer)
+            };
+            return {
+                inner: root._lerp(cl.inner, R.inner, k),
+                outer: root._lerp(cl.outer, R.outer, k),
+                uc1: root._lerp(cl.uc1, R.uc1, k),
+                uc2: root._lerp(cl.uc2, R.uc2, k),
+                lc1: root._lerp(cl.lc1, R.lc1, k),
+                lc2: root._lerp(cl.lc2, R.lc2, k)
+            };
+        }
+        const k = t - 1;
+        return {
+            inner: root._lerp(R.inner, N.inner, k),
+            outer: root._lerp(R.outer, N.outer, k),
+            uc1: root._lerp(R.uc1, N.uc1, k),
+            uc2: root._lerp(R.uc2, N.uc2, k),
+            lc1: root._lerp(R.lc1, N.lc1, k),
+            lc2: root._lerp(R.lc2, N.lc2, k)
+        };
+    }
+
+    // --- tomoe from the official Sharingan_triple.svg --------------------
+    // Local coords are SVG units relative to the eye centre (150,150),
+    // scaled by s = R / 145 so the head lands exactly on the ring (r=90).
+    function _tomoe(ctx: var, s: real): void {
+        ctx.beginPath();
+        ctx.arc(-90 * s, 0, 20 * s, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.beginPath();
+        ctx.moveTo(-90 * s, 20 * s);
+        ctx.lineTo(-90.6 * s, 2.9 * s);
+        ctx.bezierCurveTo(-106.1 * s, 2.9 * s, -121.3 * s, 4.1 * s, -131.2 * s, -16.7 * s);
+        ctx.bezierCurveTo(-127.6 * s, 6 * s, -117.2 * s, 20 * s, -90 * s, 20 * s);
+        ctx.closePath();
+        ctx.fill();
+    }
+
+    function draw(ctx: var, w: real, h: real): void {
+        ctx.clearRect(0, 0, w, h);
+
+        const p = root.poseAt(root.lidT);
+        const X = v => v.x * w;
+        const Y = v => v.y * h;
+
+        function lidPath() {
+            ctx.beginPath();
+            ctx.moveTo(X(p.inner), Y(p.inner));
+            ctx.bezierCurveTo(X(p.uc1), Y(p.uc1), X(p.uc2), Y(p.uc2), X(p.outer), Y(p.outer));
+            ctx.bezierCurveTo(X(p.lc2), Y(p.lc2), X(p.lc1), Y(p.lc1), X(p.inner), Y(p.inner));
+            ctx.closePath();
+        }
+
+        const icx = root.irisCX * w;
+        const icy = root.irisCY * h;
+        const R = root.irisR * h;
+        const s = R / 145;
+        const spinR = root.spin * Math.PI / 180;
+
+        ctx.save();
+        lidPath();
+        ctx.clip();
+
+        // Sclera
+        const sg = ctx.createLinearGradient(0, icy - R, 0, icy + R);
+        sg.addColorStop(0, "#efe9e6");
+        sg.addColorStop(1, "#d5cdca");
+        ctx.fillStyle = sg;
+        ctx.fillRect(0, 0, w, h);
+
+        // Iris (SVG gradient stops)
+        const g = ctx.createRadialGradient(icx, icy, R * 0.12, icx, icy, R);
+        g.addColorStop(0.0, "#660000");
+        g.addColorStop(0.6, "#c30000");
+        g.addColorStop(1.0, "#a00000");
+        ctx.fillStyle = g;
+        ctx.beginPath();
+        ctx.arc(icx, icy, R, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Iris rim (SVG stroke-width 10 on r145)
+        ctx.strokeStyle = "#000";
+        ctx.lineWidth = 10 * s;
+        ctx.beginPath();
+        ctx.arc(icx, icy, R - 5 * s, 0, Math.PI * 2);
+        ctx.stroke();
+
+        // Tomoe ring (SVG r90, stroke 4 @ 0.3)
+        ctx.strokeStyle = "rgba(0,0,0,0.3)";
+        ctx.lineWidth = 4 * s;
+        ctx.beginPath();
+        ctx.arc(icx, icy, 90 * s, 0, Math.PI * 2);
+        ctx.stroke();
+
+        // Three tomoe
+        ctx.fillStyle = "#000";
+        for (let i = 0; i < 3; i++) {
+            ctx.save();
+            ctx.translate(icx, icy);
+            ctx.rotate(spinR + i * (Math.PI * 2 / 3));
+            root._tomoe(ctx, s);
+            ctx.restore();
+        }
+
+        // Pupil (SVG r25)
+        ctx.fillStyle = "#000";
+        ctx.beginPath();
+        ctx.arc(icx, icy, 25 * s * root.pupilScale, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Catchlight
+        ctx.fillStyle = "rgba(255,255,255,0.45)";
+        ctx.beginPath();
+        ctx.arc(icx - R * 0.32, icy - R * 0.34, R * 0.08, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Confirm glow rim
+        if (root.ringGlow > 0) {
+            ctx.strokeStyle = "rgba(255,120,120," + (root.ringGlow * 0.8) + ")";
+            ctx.lineWidth = R * 0.05;
+            ctx.beginPath();
+            ctx.arc(icx, icy, R * 0.9, 0, Math.PI * 2);
+            ctx.stroke();
+        }
+
+        // Upper-lid shadow
+        const topY = Math.min(Y(p.uc1), Y(p.uc2));
+        const ls = ctx.createLinearGradient(0, topY, 0, topY + R * 0.9);
+        ls.addColorStop(0, "rgba(0,0,0,0.3)");
+        ls.addColorStop(1, "rgba(0,0,0,0)");
+        ctx.fillStyle = ls;
+        ctx.fillRect(0, topY, w, R);
+
+        ctx.restore(); // clip off
+
+        // Lid outline
+        ctx.strokeStyle = "#241016";
+        ctx.lineWidth = Math.max(2, h * 0.02);
+        lidPath();
+        ctx.stroke();
+
+        // Upper lash line
+        ctx.strokeStyle = "#160a0e";
+        ctx.lineWidth = Math.max(2.5, h * 0.03);
+        ctx.lineCap = "round";
+        ctx.beginPath();
+        ctx.moveTo(X(p.inner), Y(p.inner));
+        ctx.bezierCurveTo(X(p.uc1), Y(p.uc1), X(p.uc2), Y(p.uc2), X(p.outer), Y(p.outer));
+        ctx.stroke();
+    }
+
+    Canvas {
+        id: canvas
+
+        anchors.fill: parent
+        onPaint: root.draw(getContext("2d"), width, height)
+    }
+
+    // Smooth continuous spin, variable speed, no snap between phases.
+    Timer {
+        interval: 16
+        repeat: true
+        running: root.phase !== "idle"
+        onTriggered: root.spin = (root.spin + root.spinSpeed * 0.016) % 360
+    }
+
+    // Scanning "alive" pulse
+    SequentialAnimation {
+        running: root.phase === "scanning"
+        loops: Animation.Infinite
+
+        NumberAnimation {
+            target: root
+            property: "ringGlow"
+            from: 0.1
+            to: 0.42
+            duration: 780
+            easing.type: Easing.InOutSine
+        }
+        NumberAnimation {
+            target: root
+            property: "ringGlow"
+            to: 0.1
+            duration: 780
+            easing.type: Easing.InOutSine
+        }
+    }
+
+}
