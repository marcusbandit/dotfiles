+import QtQuick
+import Caelestia.Config
+import qs.components
+import qs.services
+
+Item {
+    id: root
+
+    readonly property bool shouldBeActive: FaceUnlock.active
+    property real offsetScale: shouldBeActive ? 0 : 1
+
+    // The panel background is drawn by the shared shell surface (faceUnlockBg
+    // BlobRect in ContentWindow), so this wrapper only holds the eye and lets
+    // the border blob merge seamlessly behind it, matching the dashboard.
+    visible: offsetScale < 1
+    anchors.topMargin: (-implicitHeight - 5) * offsetScale
+    implicitWidth: eye.implicitWidth + Tokens.padding.large * 2
+    implicitHeight: eye.implicitHeight + Tokens.padding.large * 2
+    opacity: 1 - offsetScale
+
+    Behavior on offsetScale {
+        Anim {}
+    }
+
+    Sharingan {
+        id: eye
+
+        anchors.centerIn: parent
+        implicitWidth: 300
+        implicitHeight: 238
+
+        phase: FaceUnlock.state
+    }
+}
