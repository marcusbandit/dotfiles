+pragma Singleton
+
+import QtQuick
+import Quickshell
+
+Singleton {
+    id: root
+
+    // "idle" | "scanning" | "confirming"
+    property string state: "idle"
+    readonly property bool active: state !== "idle"
+
+    // Minimum time the indicator stays on screen, measured from show().
+    readonly property int minVisibleMs: 1500
+    // Minimum time the confirm (open + fast spin) is shown, from recognition.
+    readonly property int minConfirmMs: 900
+
+    property bool _minVisibleDone: true
+    property bool _confirmDone: true
+
+    function show(): void {
+        if (state === "confirming")
+            return; // don't restart mid-confirm
+        state = "scanning";
+        _minVisibleDone = false;
+        minVisible.restart();
+        safety.restart();
+    }
+
+    function hide(): void {
+        // Recognised. Open the eye + speed up the tomoe IMMEDIATELY, no matter
+        // how much of the minimum time is left. The minimum only gates closing.
+        if (state === "scanning")
+            beginConfirm();
+    }
+
+    function beginConfirm(): void {
+        state = "confirming";
+        _confirmDone = false;
+        confirmHold.restart();
+        safety.restart();
+    }
+
+    // Close only once BOTH the minimum on-screen time and the minimum confirm
+    // display time have elapsed.
+    function _maybeClose(): void {
+        if (state === "confirming" && _minVisibleDone && _confirmDone) {
+            state = "idle";
+            safety.stop();
+        }
+    }
+
+    Timer {
+        id: minVisible
+
+        interval: root.minVisibleMs
+        onTriggered: {
+            root._minVisibleDone = true;
+            root._maybeClose();
+        }
+    }
+
+    Timer {
+        id: confirmHold
+
+        interval: root.minConfirmMs
+        onTriggered: {
+            root._confirmDone = true;
+            root._maybeClose();
+        }
+    }
+
+    Timer {
+        id: safety
+
+        // Net so a missed camera-close event can't leave the eye stuck open
+        interval: 30000
+        onTriggered: root.state = "idle"
+    }
+}
