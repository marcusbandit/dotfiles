+#!/usr/bin/env python3
+"""
+wifi-qr-scan.py - camera QR scanner for the caelestia wifi popout.
+
+Grabs frames from the webcam with ffmpeg, publishes the latest frame as a JPEG the
+shell can display as a live preview, and prints every QR code it decodes on stdout.
+Parsing the `WIFI:` payload and connecting is the QML side's job; this only reads.
+
+Line protocol on stdout (line buffered):
+
+    READY <preview-path>    camera is live, preview file is being updated
+    CODE <json-string>      a decoded QR payload, JSON encoded (may repeat)
+    ERROR <message>         fatal, the process exits right after
+
+The decoder (zxing-cpp) lives in a private venv that this script creates on first
+run and re-execs into, so the shell only ever needs to invoke this one file. Once
+the venv exists nothing here touches the network, which matters: scanning a wifi QR
+is something you do precisely when you have no working connection.
+"""
+
+from __future__ import annotations
+
+import io
+import json
+import os
+import re
+import shutil
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+from typing import NoReturn
+
+DEPS = ["zxing-cpp", "pillow"]
+BOOTSTRAP_GUARD = "CAELESTIA_QR_BOOTSTRAPPED"
+
+SOI = b"\xff\xd8"  # JPEG start of image
+EOI = b"\xff\xd9"  # JPEG end of image
+
+# Formats a colour webcam offers. The IR camera used for face unlock only does
+# GREY, so preferring these picks the right device on laptops that expose both.
+COLOUR_FORMATS = ("MJPG", "YUYV")
+
+
+def emit(kind: str, value: str = "") -> None:
+    print(f"{kind} {value}".rstrip(), flush=True)
+
+
+def die(message: str) -> NoReturn:
+    emit("ERROR", message)
+    sys.exit(1)
+
+
+# --- venv bootstrap ---------------------------------------------------------
+
+
+def venv_dir() -> Path:
+    data = os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share"
+    return Path(data) / "caelestia" / "wifi-qr-venv"
+
+
+def venv_python() -> Path:
+    return venv_dir() / "bin" / "python"
+
+
+def create_venv() -> None:
+    uv = shutil.which("uv")
+    if not uv:
+        die("uv is not installed - needed once to set up the QR decoder")
+
+    emit("SETUP", "installing QR decoder")
+    steps = [
+        [uv, "venv", "--python", sys.executable, str(venv_dir())],
+        [uv, "pip", "install", "--python", str(venv_python()), *DEPS],
+    ]
+    for step in steps:
+        result = subprocess.run(step, capture_output=True, text=True)
+        if result.returncode != 0:
+            detail = (result.stderr or result.stdout).strip().splitlines()
+            die(f"QR decoder setup failed: {detail[-1] if detail else 'unknown error'}")
+
+
+def bootstrap() -> None:
+    """Re-exec into the private venv, creating it the first time."""
+    # sys.prefix, not sys.executable: the venv's python is a symlink to the system
+    # one, so resolving it would make every run look like it was already inside
+    if Path(sys.prefix).resolve() == venv_dir().resolve():
+        return
+
+    python = venv_python()
+    if not python.exists():
+        create_venv()
+
+    os.environ[BOOTSTRAP_GUARD] = "1"
+    os.execv(str(python), [str(python), str(Path(__file__).resolve()), *sys.argv[1:]])
+
+
+def ensure_deps() -> None:
+    """Inside the venv: import the decoder, repairing the venv once if it is broken."""
+    global Image, zxingcpp
+    try:
+        from PIL import Image
+        import zxingcpp
+    except ImportError as exc:
+        if os.environ.get(BOOTSTRAP_GUARD) == "repairing":
+            die(f"QR decoder unavailable: {exc}")
+        shutil.rmtree(venv_dir(), ignore_errors=True)
+        os.environ[BOOTSTRAP_GUARD] = "repairing"
+        create_venv()
+        python = venv_python()
+        os.execv(str(python), [str(python), str(Path(__file__).resolve()), *sys.argv[1:]])
+
+
+# --- camera -----------------------------------------------------------------
+
+
+def pick_device() -> str:
+    override = os.environ.get("CAELESTIA_QR_DEVICE")
+    if override:
+        return override
+
+    devices = sorted(
+        (p for p in Path("/dev").glob("video*") if p.name[5:].isdigit()),
+        key=lambda p: int(p.name[5:]),
+    )
+    if not devices:
+        die("no camera found")
+
+    v4l2 = shutil.which("v4l2-ctl")
+    if v4l2:
+        for device in devices:
+            probe = subprocess.run(
+                [v4l2, "-d", str(device), "--list-formats"],
+                capture_output=True,
+                text=True,
+            )
+            if any(fmt in probe.stdout for fmt in COLOUR_FORMATS):
+                return str(device)
+
+    return str(devices[0])
+
+
+def ffmpeg_command(device: str, size: str, fps: int, native_mjpeg: bool) -> list[str]:
+    command = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin", "-f", "v4l2"]
+    if native_mjpeg:
+        command += ["-input_format", "mjpeg", "-video_size", size]
+    command += ["-i", device]
+    # One re-encoded MJPEG stream serves both jobs: it is what gets decoded and,
+    # byte for byte, what the shell displays as the preview.
+    command += ["-vf", f"fps={fps}", "-q:v", "4", "-f", "image2pipe", "-vcodec", "mjpeg", "pipe:1"]
+    return command
+
+
+def start_ffmpeg(device: str, size: str, fps: int) -> subprocess.Popen:
+    if not shutil.which("ffmpeg"):
+        die("ffmpeg is not installed")
+
+    last_error = ""
+    for native_mjpeg in (True, False):
+        proc = subprocess.Popen(
+            ffmpeg_command(device, size, fps, native_mjpeg),
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+        )
+        assert proc.stdout and proc.stderr
+        header = proc.stdout.read(2)
+        if header == SOI:
+            proc._first_bytes = header  # type: ignore[attr-defined]
+            return proc
+
+        proc.kill()
+        last_error = (proc.stderr.read().decode(errors="replace") or "").strip()
+        if "Device or resource busy" in last_error:
+            die("the camera is already in use")
+
+    tail = last_error.splitlines()[-1] if last_error else "camera did not start"
+    die(f"camera error: {tail}")
+
+
+def frames(proc: subprocess.Popen):
+    """Yield complete JPEG frames from the MJPEG pipe, skipping any backlog."""
+    assert proc.stdout
+    buffer = getattr(proc, "_first_bytes", b"")
+    while True:
+        chunk = proc.stdout.read(65536)
+        if not chunk:
+            return
+        buffer += chunk
+
+        batch = []
+        while True:
+            start = buffer.find(SOI)
+            if start < 0:
+                buffer = b""
+                break
+            end = buffer.find(EOI, start + 2)
+            if end < 0:
+                buffer = buffer[start:]
+                break
+            batch.append(buffer[start : end + 2])
+            buffer = buffer[end + 2 :]
+
+        # Only the newest frame is worth looking at - the rest are already stale.
+        if batch:
+            yield batch[-1]
+
+
+# --- main -------------------------------------------------------------------
+
+
+def preview_path() -> Path:
+    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/{os.getuid()}"
+    directory = Path(runtime) / "caelestia"
+    directory.mkdir(parents=True, exist_ok=True)
+    return directory / "wifi-qr-preview.jpg"
+
+
+def publish(frame: bytes, path: Path) -> None:
+    """Swap the preview in atomically so the shell never reads a half written frame."""
+    scratch = path.with_suffix(".tmp")
+    scratch.write_bytes(frame)
+    os.replace(scratch, path)
+
+
+def parse_args(argv: list[str]) -> dict:
+    options = {"device": "", "size": "1280x720", "fps": 6, "timeout": 180.0}
+    for arg in argv:
+        match = re.fullmatch(r"--(device|size|fps|timeout)=(.+)", arg)
+        if not match:
+            die(f"unknown argument: {arg}")
+        key, value = match.groups()
+        options[key] = int(value) if key == "fps" else float(value) if key == "timeout" else value
+    return options
+
+
+def main() -> None:
+    options = parse_args(sys.argv[1:])
+    device = options["device"] or pick_device()
+    preview = preview_path()
+
+    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
+        signal.signal(sig, lambda *_: sys.exit(0))
+
+    proc = start_ffmpeg(device, options["size"], options["fps"])
+    deadline = None
+    last_payload = ""
+
+    try:
+        for frame in frames(proc):
+            if deadline is None:
+                emit("READY", str(preview))
+                deadline = time.monotonic() + options["timeout"]
+            elif time.monotonic() > deadline:
+                die("timeout")
+
+            publish(frame, preview)
+
+            image = Image.open(io.BytesIO(frame)).convert("L")
+            for barcode in zxingcpp.read_barcodes(image, formats=zxingcpp.BarcodeFormat.QRCode):
+                if barcode.text and barcode.text != last_payload:
+                    last_payload = barcode.text
+                    emit("CODE", json.dumps(barcode.text))
+    finally:
+        proc.terminate()
+        try:
+            proc.wait(timeout=2)
+        except subprocess.TimeoutExpired:
+            proc.kill()
+        preview.unlink(missing_ok=True)
+
+
+if __name__ == "__main__":
+    bootstrap()
+    ensure_deps()
+    main()
