--- /dev/null
+++ b/modules/cameraindicator/CameraDetector.qml
@@ -0,0 +1,91 @@
+pragma Singleton
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import qs.services
+
+// Camera-in-use detection for the privacy indicator. A singleton so the
+// watchers, poll and IPC handler exist exactly once, shared by the panel
+// on every screen.
+Singleton {
+    id: root
+
+    readonly property int minVisibleMs: 2000 // keep the dot up this long after an open
+    readonly property int pollMs: 1000
+
+    // Three detection sources, OR'd together:
+    //   held    - a process is *holding* a video node open (sustained use: calls,
+    //             recorders, browser getUserMedia). fuser poll, sees your procs.
+    //   pulse   - a live open *event* on any video node (catches root howdy scans
+    //             and sub-second opens that a 1s poll would miss). inotify.
+    //   face    - the howdy face-unlock is on screen (shares the eye's timing).
+    //   forced  - manual IPC override, for testing.
+    property bool held: false
+    property bool forced: false
+    readonly property bool active: held || openPulse.running || FaceUnlock.active || forced
+
+    // --- live open events (root-visible, catches fast opens) ------------------
+    Process {
+        id: watch
+
+        running: true
+        command: ["sh", "-c", "exec inotifywait -q -m -e open /dev/video* 2>/dev/null"]
+        stdout: SplitParser {
+            onRead: openPulse.restart() // any open -> show for >= minVisibleMs
+        }
+        onRunningChanged: if (!running)
+            relaunch.restart() // re-arm if it dies or is periodically recycled
+    }
+
+    Timer {
+        id: openPulse
+
+        interval: root.minVisibleMs
+    }
+
+    // Debounced relaunch so a failing watcher can't tight-loop.
+    Timer {
+        id: relaunch
+
+        interval: 1500
+        onTriggered: watch.running = true
+    }
+
+    // Periodically recycle the watcher; a long-lived inotify -m can go deaf.
+    Timer {
+        interval: 600000
+        repeat: true
+        running: true
+        onTriggered: watch.running = false
+    }
+
+    // --- sustained-holder poll ------------------------------------------------
+    Timer {
+        interval: root.pollMs
+        repeat: true
+        running: true
+        triggeredOnStart: true
+        onTriggered: poll.running = true
+    }
+
+    Process {
+        id: poll
+
+        command: ["sh", "-c", "fuser /dev/video* >/dev/null 2>&1 && echo on || echo off"]
+        stdout: StdioCollector {
+            onStreamFinished: root.held = text.trim() === "on"
+        }
+    }
+
+    // Manual test, no live camera needed:
+    //   qs -c caelestia ipc call camera set on
+    //   qs -c caelestia ipc call camera set off
+    IpcHandler {
+        target: "camera"
+
+        function set(v: string): void {
+            root.forced = v === "on";
+        }
+    }
+}
--- /dev/null
+++ b/modules/cameraindicator/Wrapper.qml
@@ -0,0 +1,37 @@
+import QtQuick
+import Caelestia.Config
+import qs.components
+import qs.modules.cameraindicator
+
+Item {
+    id: root
+
+    readonly property color dotColour: "#3b82f6"
+    readonly property int dotSize: 9
+
+    readonly property bool shouldBeActive: CameraDetector.active
+    property real offsetScale: shouldBeActive ? 0 : 1
+
+    // The chip body is drawn by the shared shell surface (cameraBg BlobRect
+    // in ContentWindow), so this wrapper only holds the dot and lets the
+    // border blob morph around it, matching the dashboard/notifications.
+    visible: offsetScale < 1
+    anchors.topMargin: (-implicitHeight - 5) * offsetScale
+    implicitWidth: dot.implicitWidth + Tokens.padding.medium * 2
+    implicitHeight: dot.implicitHeight + Tokens.padding.medium * 2
+    opacity: 1 - offsetScale
+
+    Behavior on offsetScale {
+        Anim {}
+    }
+
+    StyledRect {
+        id: dot
+
+        anchors.centerIn: parent
+        implicitWidth: root.dotSize
+        implicitHeight: root.dotSize
+        radius: Tokens.rounding.full
+        color: root.dotColour
+    }
+}
