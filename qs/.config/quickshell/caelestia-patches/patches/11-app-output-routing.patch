+    function moveStreamToSink(stream: PwNode, targetSink: PwNode): void {
+        if (!stream?.id) return;
+        if (targetSink?.id) {
+            Quickshell.execDetached(["pw-metadata", "-n", "default", "--", stream.id.toString(), "target.node", targetSink.id.toString()]);
+        } else {
+            Quickshell.execDetached(["pw-metadata", "-n", "default", "--", stream.id.toString(), "target.node", "-1"]);
+        }
+    }
+
+    function moveStreamToSource(stream: PwNode, targetSource: PwNode): void {
+        if (!stream?.id) return;
+        if (targetSource?.id) {
+            Quickshell.execDetached(["pw-metadata", "-n", "default", "--", stream.id.toString(), "target.node", targetSource.id.toString()]);
+        } else {
+            Quickshell.execDetached(["pw-metadata", "-n", "default", "--", stream.id.toString(), "target.node", "-1"]);
+        }
+    }
