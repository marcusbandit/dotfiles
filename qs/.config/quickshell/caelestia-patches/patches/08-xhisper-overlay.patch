--- /dev/null
+++ b/modules/xhisper/Xhisper.qml
@@ -0,0 +1,287 @@
+import qs.components
+import qs.components.containers
+import qs.components.effects
+import qs.services
+import Quickshell
+import Quickshell.Wayland
+import Quickshell.Io
+import QtQuick
+
+Scope {
+    id: xhisperScope
+
+    property string xhisperState: "hidden" // "hidden" | "recording" | "transcribing" | "formatting"
+    property real volumeLevel: 0.0         // 0.0 – 1.0, updated by xhisper-volume
+    property real gapBottom: 10            // matches Hyprland gaps_out, loaded on startup
+
+    readonly property real pillW: 160
+    readonly property real pillH: 52
+
+    // Post-recording stages show a cycling status line so the wait is not a
+    // black box: whisper flavour while transcribing, llama flavour while the
+    // formatter runs. Messages rotate Claude-style, random but never twice
+    // in a row.
+    readonly property bool processing: xhisperState === "transcribing" || xhisperState === "formatting"
+    readonly property var stageMessages: ({
+        transcribing: ["Untangling syllables", "Consulting whisper", "Deciphering the mumbles", "Rewinding the tape", "Turning air into text", "Reading between the pauses"],
+        formatting: ["Waking the llama", "Combing the commas", "The llama is tidying up", "Herding stray sentences", "Sprinkling punctuation", "Teaching commas manners"]
+    })
+    property string statusText: ""
+    property int msgIndex: -1
+
+    function pickStatus(): void {
+        const pool = stageMessages[xhisperState];
+        if (!pool) {
+            statusText = "";
+            return;
+        }
+        let i = Math.floor(Math.random() * pool.length);
+        if (pool.length > 1 && i === msgIndex)
+            i = (i + 1) % pool.length;
+        msgIndex = i;
+        statusText = pool[i] + "…";
+    }
+
+    onXhisperStateChanged: {
+        msgIndex = -1;
+        pickStatus();
+    }
+
+    Timer {
+        interval: 2400
+        repeat: true
+        running: xhisperScope.processing
+        onTriggered: xhisperScope.pickStatus()
+    }
+
+    // Read gaps_out once on load so the pill gap matches the system edge gap
+    Process {
+        id: gapQuery
+        running: true
+        command: ["sh", "-c", "hyprctl getoption general:gaps_out -j 2>/dev/null | jq -r 'if .int > 0 then .int else 10 end' 2>/dev/null || echo 10"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                const v = parseInt(text.trim());
+                if (!isNaN(v) && v > 0)
+                    xhisperScope.gapBottom = v;
+            }
+        }
+    }
+
+    // One-shot volume sampler — restarted by volumePollTimer
+    Process {
+        id: volumeProc
+        command: ["/home/bandit/.local/bin/xhisper-volume"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                const raw = parseFloat(text.trim());
+                if (!isNaN(raw))
+                    // Power curve: boosts quiet sounds visually (0.05 raw → ~0.22 scaled)
+                    xhisperScope.volumeLevel = raw > 0 ? Math.pow(raw, 0.4) : 0.0;
+            }
+        }
+    }
+
+    // Polls mic volume at ~20 Hz while recording
+    Timer {
+        id: volumePollTimer
+        interval: 50
+        repeat: true
+        running: xhisperScope.xhisperState === "recording"
+        triggeredOnStart: true
+        onTriggered: volumeProc.running = true
+        onRunningChanged: {
+            if (!running)
+                xhisperScope.volumeLevel = 0.0;
+        }
+    }
+
+    Variants {
+        model: Quickshell.screens
+
+        StyledWindow {
+            id: win
+
+            required property ShellScreen modelData
+
+            screen: modelData
+            name: "xhisper"
+            WlrLayershell.exclusionMode: ExclusionMode.Ignore
+            WlrLayershell.layer: WlrLayer.Overlay
+            WlrLayershell.keyboardFocus: WlrKeyboardFocus.None
+            mask: clickThrough
+
+            anchors.top: true
+            anchors.bottom: true
+            anchors.left: true
+            anchors.right: true
+
+            Region { id: clickThrough }
+
+            readonly property bool shouldShow: xhisperScope.xhisperState !== "hidden"
+
+            readonly property var activeWin: Hypr.activeToplevel?.lastIpcObject
+            // No active toplevel (fresh shell start, empty workspace): fall
+            // back to bottom-center of the screen instead of parking the
+            // pill at negative offscreen coordinates. Also kills the
+            // "Cannot read property '0' of undefined" log spam.
+            readonly property bool haveWin: (activeWin?.at ?? undefined) !== undefined && (activeWin?.size ?? undefined) !== undefined
+            readonly property real targetX: haveWin
+                ? activeWin.at[0] - modelData.x + activeWin.size[0] / 2 - pillItem.width / 2
+                : (modelData.width - pillItem.width) / 2
+            readonly property real targetY: haveWin
+                ? activeWin.at[1] - modelData.y + activeWin.size[1] - xhisperScope.pillH - xhisperScope.gapBottom
+                : modelData.height - xhisperScope.pillH - xhisperScope.gapBottom * 4
+
+            property real smoothX: targetX
+            property real smoothY: targetY
+
+            onShouldShowChanged: {
+                if (shouldShow) {
+                    smoothX = targetX;
+                    smoothY = targetY;
+                }
+            }
+
+            Timer {
+                interval: 16
+                repeat: true
+                running: win.shouldShow
+                onTriggered: {
+                    const dt = interval / 1000.0;
+                    const f = 1 - Math.exp(-10.0 * dt);
+                    win.smoothX += (win.targetX - win.smoothX) * f;
+                    win.smoothY += (win.targetY - win.smoothY) * f;
+                }
+            }
+
+            Item {
+                id: pillItem
+
+                x: win.smoothX
+                y: win.smoothY
+                // Grows to fit the status line while processing, never below
+                // the recording pill's fixed width
+                width: Math.max(xhisperScope.pillW, contentRow.implicitWidth + 36)
+                height: xhisperScope.pillH
+
+                opacity: win.shouldShow ? 1 : 0
+                scale: win.shouldShow ? 1 : 0.88
+
+                Behavior on width { Anim {} }
+                Behavior on opacity { Anim {} }
+                Behavior on scale { Anim {} }
+
+                StyledRect {
+                    id: pill
+
+                    anchors.fill: parent
+                    radius: height / 2
+                    color: Colours.palette.m3surfaceContainer
+                    border.width: 1
+                    border.color: Colours.palette.m3outlineVariant
+
+                    Elevation {
+                        anchors.fill: parent
+                        radius: parent.radius
+                        z: -1
+                        level: 3
+                    }
+
+                    // Bars + (while processing) a cycling status message
+                    Row {
+                        id: contentRow
+
+                        anchors.centerIn: parent
+                        spacing: 12
+
+                        // Unified bars — recording drives height via volume,
+                        // processing settles height and adds sine Y-wave.
+                        // Exponential smoothing makes the handoff seamless.
+                        Row {
+                        anchors.verticalCenter: parent.verticalCenter
+                        spacing: 6
+                        height: 38
+                        visible: xhisperScope.xhisperState !== "hidden"
+
+                        Repeater {
+                            model: 5
+
+                            delegate: Rectangle {
+                                id: bar
+
+                                required property int index
+
+                                readonly property real barFactor: [0.32, 0.62, 1.0, 0.55, 0.26][index]
+                                readonly property real barSpeed:  [11.0, 7.0, 15.0, 8.5, 12.0][index]
+
+                                width: 4
+                                radius: 2
+                                anchors.verticalCenter: parent.verticalCenter
+                                color: Colours.palette.m3primary
+
+                                property real smoothH: 4
+                                property real smoothY: 0
+                                height: smoothH
+                                transform: Translate { y: bar.smoothY }
+
+                                Timer {
+                                    interval: 16
+                                    repeat: true
+                                    running: xhisperScope.xhisperState !== "hidden"
+                                    onTriggered: {
+                                        const dt = interval / 1000.0;
+                                        const state = xhisperScope.xhisperState;
+
+                                        // Height engine
+                                        let hTarget;
+                                        if (state === "recording") {
+                                            const vol = xhisperScope.volumeLevel;
+                                            const noise = (Math.random() - 0.5) * vol * 22;
+                                            hTarget = 4 + (vol * 52 * bar.barFactor) + noise;
+                                        } else {
+                                            hTarget = 18;
+                                        }
+                                        bar.smoothH += (hTarget - bar.smoothH) * (1 - Math.exp(-bar.barSpeed * dt));
+
+                                        // Y-wave engine
+                                        const phase = bar.index * (2 * Math.PI / 5);
+                                        const yTarget = xhisperScope.processing
+                                            ? 10 * Math.sin(Date.now() / 200 + phase)
+                                            : 0;
+                                        bar.smoothY += (yTarget - bar.smoothY) * (1 - Math.exp(-8.0 * dt));
+                                    }
+                                    onRunningChanged: {
+                                        if (!running) {
+                                            bar.smoothH = 4;
+                                            bar.smoothY = 0;
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                        }
+
+                        StyledText {
+                            id: statusLabel
+
+                            anchors.verticalCenter: parent.verticalCenter
+                            visible: xhisperScope.processing
+                            animate: true
+                            text: xhisperScope.statusText
+                            color: Colours.palette.m3onSurfaceVariant
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    IpcHandler {
+        target: "xhisper"
+
+        function set(state: string): void {
+            xhisperScope.xhisperState = state;
+        }
+    }
+}
